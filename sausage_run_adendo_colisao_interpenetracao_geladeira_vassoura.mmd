%% E — ORDEM
%% ============================================================================

ORDER --> O1["1 — Corrigir cálculo de hitbox direcional do Scooby"]
O1 --> O2["2 — Validar nova hitbox ANTES de aplicar mudança de direção"]
O2 --> O3["3 — Implementar resolução X/Y + correção de penetração residual"]
O3 --> O4["4 — Revisar todos os pontos onde posição/direção do Scooby é alterada"]
O4 --> O5["5 — Reduzir colisor esquerdo da geladeira"]
O5 --> O6["6 — Reposicionar vassoura dentro do balde azul"]
O6 --> O7["7 — Recalibrar colisão do conjunto balde/vassoura"]
O7 --> O8["8 — Executar testes de quinas, corredores e mudanças rápidas de direção"]
O8 --> VALID

%% ============================================================================
%% F — VALIDAÇÃO
%% ============================================================================

VALID --> V1["F1 — Invariante crítica de colisão<br/><br/>Após cada update:<br/>para todo obstáculo sólido,<br/>overlap(hitboxScooby, obstaculo) deve ser 0.<br/><br/>Contato de borda é permitido; penetração não."]

VALID --> V2["F2 — Teste de mudança de direção junto a obstáculo<br/><br/>Aceite:<br/>Scooby pode virar encostado em móveis sem a nova hitbox entrar no obstáculo e sem ficar preso."]

VALID --> V3["F3 — Teste de deslizamento<br/><br/>Aceite:<br/>ao pressionar diagonal contra uma parede/móvel, Scooby deve deslizar pelo eixo livre em vez de congelar."]

VALID --> V4["F4 — Teste da geladeira<br/><br/>Aceite:<br/>Scooby consegue passar pelo lado esquerdo da geladeira quando visualmente há corredor, sem atravessar a geladeira e sem ficar preso."]

VALID --> V5["F5 — Teste do balde/vassoura<br/><br/>Aceite:<br/>- vassoura posicionada dentro do balde;<br/>- balde azul inteiro;<br/>- vassoura sem corte indevido;<br/>- sem pedaço de madeira residual;<br/>- colisão compacta e coerente."]

VALID --> V6["F6 — Teste global de obstáculos<br/><br/>Percorrer todos os móveis das quatro fases, contornando cada um nos quatro sentidos e mudando direção junto às bordas.<br/><br/>Aceite: nenhum softlock causado por interpenetração da hitbox."]

VALID --> V7["DEFINIÇÃO DE PRONTO<br/><br/>A implementação só é considerada concluída quando a hitbox do Scooby nunca permanecer dentro de uma hitbox de obstáculo, mudanças de direção próximas a móveis não causarem travamento, o caminho esquerdo da geladeira estiver utilizável e o conjunto balde/vassoura estiver visualmente correto."]
